<?xml version="1.0" encoding="utf-8"?>
<!--
  The Monyx mark: a disc cut by a cross into a top half and two bottom
  quarters — a pie chart with the slices pulled apart.

  Sized against the middle 72 of the 108 canvas, not against the 108. An
  adaptive icon only ever shows that middle square, so scaling the mark to the
  full canvas would push it right up against the mask instead of leaving it the
  same breathing room it has in the source square (where it is 60.5% across).

  The corners are rounded by geometry INSET by k and stroked back out by 2k
  with a round join: r-k stroked by 2k is r again, with every corner turned.
  Writing the rounding into the path data instead is four arc tangencies per
  piece, solved by hand.

  Kept in step with com.monyx.ui.theme.MonyxMark, which is this shape at a
  24dp viewport. Change one, change the other.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F0F1EB"
        android:strokeColor="#F0F1EB"
        android:strokeWidth="2.11"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M74.41,50.42 A20.73,20.73 0 0 0 33.59,50.42 Z" />
    <path
        android:fillColor="#F0F1EB"
        android:strokeColor="#F0F1EB"
        android:strokeWidth="2.11"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M33.59,57.58 L50.42,57.58 L50.42,74.41 A20.73,20.73 0 0 1 33.59,57.58 Z" />
    <path
        android:fillColor="#F0F1EB"
        android:strokeColor="#F0F1EB"
        android:strokeWidth="2.11"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M57.58,57.58 L74.41,57.58 A20.73,20.73 0 0 1 57.58,74.41 Z" />
</vector>
