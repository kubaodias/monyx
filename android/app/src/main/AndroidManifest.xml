<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires this at runtime, and without it every push is
         dropped SILENTLY — the server sees a successful delivery and the phone
         shows nothing. Asked on first visit to the Budget screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Adding a transaction by voice. Asked on the first long press of the Add
         tab and never before it: the recogniser runs IN this process, which is
         what makes hold-to-talk possible at all. The full-screen system dialog
         (RecognizerIntent) would need no permission of ours and cannot express
         a hold. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Do not delete this. It is invisible and it is load-bearing: with
         targetSdk 30 or above, package visibility filtering hides every
         recognition service from us, and SpeechRecognizer.isRecognitionAvailable
         then returns false on a phone that plainly does have one. The feature
         would hide itself, correctly and permanently, for no reason at all. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".MonyxApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Monyx"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        xmlns:tools="http://schemas.android.com/tools"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false">
        <!-- allowBackup defaults to true, and Google Auto Backup would copy Room
             and DataStore to the cloud and restore them onto a NEW phone,
             session token included. Two devices would then share one `devices`
             row, so revoking one revokes both. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Monyx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A home screen shortcut saves taps, not milliseconds — it is the
                 same cold start. Point it at MainActivity with an extra and
                 branch the start destination. Do not add a second Activity. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".notifications.MonyxMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- AppCompat persists the chosen language itself when this holder
             service carries autoStoreLocales. Without it the selection is lost
             on process death below API 33, where there is no framework
             LocaleManager to remember it. The service is never started; it
             exists only to carry the meta-data. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>
</manifest>
