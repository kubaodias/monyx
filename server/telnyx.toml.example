# Template. Copy to telnyx.toml and fill in the identifiers.
#
#     cp server/telnyx.toml.example server/telnyx.toml
#
# telnyx.toml itself is gitignored: a function's id is also its hostname
# (<name>-<first 8 of func_id>-<n>.telnyxcompute.com), so committing it publishes
# the address of the deployment. Keeping it out of Git does not make the address
# a secret on an installed phone — it only stops it being handed to a reader of
# the repository.

name = "<your function name>"
main = "src/index.ts"
compatibility_date = "2026-05-01"

# The shared source of truth. Bound as env.DB: bindings come from
# `import { env } from "@telnyx/edge-runtime"`, never from the fetch argument.
[storage.sqldb.DB]
id = "<your sqldb id>"

# Caches the FCM OAuth access token (key "fcm/token" — KV keys may not
# contain a colon). The cached value carries its own expires_at.
[storage.kv.KV]
id = "<your kv id>"

# Whole service-account JSON, parsed in code: a bare PEM in an env var loses
# its newlines.
[[secrets]]
binding = "FCM_SERVICE_ACCOUNT"
name = "FCM_SERVICE_ACCOUNT"

# Shared secret for POST /cron/daily. No device calls that route.
[[secrets]]
binding = "CRON_SECRET"
name = "CRON_SECRET"

# Who may reach the household by phone, which household they reach, and the PIN
# that proves it: a JSON array of {msisdn, household_id, name, pin}. A secret
# rather than a table, because phone numbers are personal data and this keeps
# them out of both the repository and the database backups.
[[secrets]]
binding = "VOICE_ALLOWLIST"
name = "VOICE_ALLOWLIST"

# Authenticates the assistant's call-setup webhook. It travels in the URL
# because the assistant config has a URL field and no headers.
[[secrets]]
binding = "VOICE_CONTEXT_TOKEN"
name = "VOICE_CONTEXT_TOKEN"

# Authenticates the assistant's webhook TOOL, which does have headers.
[[secrets]]
binding = "VOICE_TOOL_SECRET"
name = "VOICE_TOOL_SECRET"

# The platform's own Telnyx client, for POST /voice/note and nothing else.
#
# A singleton table, not an array: [[telnyx_api]] is the deprecated spelling.
# What it puts on env.TELNYX is a fully configured SDK client whose bearer the
# runtime's auth proxy substitutes on the way out of the pod — the function is
# already authenticated as itself, so there is no API key in this repository, in
# a secret store, or in memory here. Nothing to rotate and nothing to leak.
[telnyx]
binding = "TELNYX"

# Second layer on enrolment; 10-character invite codes are the real defence.
[[ratelimits]]
name = "ENROLL_LIMIT"
limit = 10
period = 60

# The note route is the only one that costs money per call, and it is a
# cosmetic field. Counted per household rather than per IP: the bound worth
# having is on the family that would be billed, not on whatever network they
# are on. Ten a minute is far more voice entries than anyone makes — a hold, a
# sentence and a glance is ten seconds — so it never touches real use and caps
# a runaway client hard. The platform allows periods of 10 or 60 seconds only.
[[ratelimits]]
name = "NOTE_LIMIT"
limit = 10
period = 60


# Written back by `telnyx-edge ship` the first time it deploys. Leave this block
# out entirely to have a NEW function created; keep it to update that one.
# [edge_compute]
# func_id = "<written by ship>"
# func_name = "<written by ship>"
